{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluff-and-tell",
  "main": "server/cloudflare.mjs",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "RequestBudget"] },
  ],
  "env": {
    "staging": {
      "name": "bluff-and-tell-staging",
      "vars": { "APP_ENV": "staging" },
      "durable_objects": {
        "bindings": [
          { "name": "GAME_ROOMS", "class_name": "GameRoom" },
          { "name": "REQUEST_BUDGETS", "class_name": "RequestBudget" },
        ],
      },
    },
    "production": {
      "name": "bluff-and-tell",
      "vars": { "APP_ENV": "production" },
      "durable_objects": {
        "bindings": [
          { "name": "GAME_ROOMS", "class_name": "GameRoom" },
          { "name": "REQUEST_BUDGETS", "class_name": "RequestBudget" },
        ],
      },
    },
  },
}
